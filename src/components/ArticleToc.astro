---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const sections = headings.filter((h) => h.depth === 2);

/** Shorter labels for long section titles in the TOC dropdown only. */
const TOC_ABBREVIATIONS: Record<string, string> = {
  '6-quantum-and-symmetric-encryption': '6. PQ Symmetric Cryptography',
  '7-quantum-and-asymmetric-cryptography': '7. PQ Asymmetric Cryptography',
  '8-introduction-to-post-quantum-key-exchange': '8. PQ Key Exchange',
  '9-introduction-to-post-quantum-digital-signatures': '9. PQ Digital Signatures',
};

function tocLabel(heading: MarkdownHeading): string {
  return TOC_ABBREVIATIONS[heading.slug] ?? heading.text;
}
---

{sections.length > 0 && (
  <details class="article-toc-dropdown">
    <summary class="article-toc-trigger">Jump to section</summary>
    <nav class="article-toc-nav" aria-label="Sections">
      <ul>
        {sections.map((heading) => (
          <li>
            <a href={`#${heading.slug}`}>{tocLabel(heading)}</a>
          </li>
        ))}
      </ul>
    </nav>
  </details>
)}

<script>
  document.querySelectorAll('.article-toc-nav a').forEach((link) => {
    link.addEventListener('click', () => {
      const dropdown = link.closest('.article-toc-dropdown');
      if (dropdown instanceof HTMLDetailsElement) {
        dropdown.open = false;
      }
    });
  });
</script>
