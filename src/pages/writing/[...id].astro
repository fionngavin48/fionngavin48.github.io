---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { monthYearLong } from '../../lib/date';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const byline = [
  post.data.author,
  monthYearLong(post.data.publishedAt),
  post.data.readingTime,
].filter(Boolean).join(' · ');
---

<Base title={post.data.title} description={post.data.description}>
  <article class="article-main">
    <a class="back-link" href="/writing/">← writing</a>
    <header class="article-head">
      <h1>{post.data.title}</h1>
      <div class="article-meta">{byline}</div>
    </header>
    <div class="prose article-prose">
      <Content />
    </div>
    <a class="back-link back-link-bottom" href="/writing/">← writing</a>
  </article>
</Base>
