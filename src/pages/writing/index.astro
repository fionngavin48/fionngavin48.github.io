---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { monthYear } from '../../lib/date';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<Base title="Writing" description="My blogs and notes. Security, systems, and what I'm working on.">
<div class="page-sections">
  <section class="intro">
    <h1>Writing</h1>
    <p class="lead">My blogs and notes. Security, systems, and what I'm working on.</p>
  </section>

  <div class="block writing-sections">
    <section id="articles">
      <h2 class="section-title">Articles</h2>
      {
        posts.length > 0 ? (
          <div class="writing-list">
            {posts.map((p) => (
              <a class="post" href={`/writing/${p.id}/`}>
                <time datetime={p.data.publishedAt.toISOString()}>{monthYear(p.data.publishedAt)}</time>
                <span class="post-title">{p.data.title}</span>
              </a>
            ))}
          </div>
        ) : (
          <p class="empty-state">Coming soon</p>
        )
      }
    </section>

    <section id="papers">
      <h2 class="section-title">Papers</h2>
      <p class="empty-state">Coming soon</p>
    </section>
  </div>
</div>
</Base>
