---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { monthYear } from '../../lib/date';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<Base title="Writing" description="Notes on security, systems, and what I'm reading.">
  <section class="intro">
    <h1>Writing</h1>
    <p class="lead">Notes on security, systems, and what I'm reading.</p>
  </section>

  <section class="block">
    <div class="writing-list">
      {
        posts.map((p) => (
          <a class="post" href={`/writing/${p.id}/`}>
            <time datetime={p.data.publishedAt.toISOString()}>{monthYear(p.data.publishedAt)}</time>
            <span class="post-title">{p.data.title}</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>
