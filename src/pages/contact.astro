---
import Base from '../layouts/Base.astro';
---

<Base title="Contact" description="Get in touch with Fionn Gavin.">
  <section class="intro">
    <h1>Contact</h1>
    <p class="lead">I'd love to hear from you. Let's connect.</p>
    <div class="links">
      <a href="mailto:fgavin@tcd.ie" data-copy="fgavin@tcd.ie"><span class="arw">✉</span> Email</a>
      <a href="https://linkedin.com/in/fionngavin" target="_blank" rel="noopener noreferrer"><span class="arw">↗</span> LinkedIn</a>
      <a href="https://github.com/fionngavin48" target="_blank" rel="noopener noreferrer"><span class="arw">↗</span> GitHub</a>
    </div>
  </section>

  <section class="block" id="cv">
    <h2 class="section-title">CV</h2>
    <p class="lead">
      My CV isn't hosted here at the moment. Drop me an
      <a class="content-link" href="mailto:fgavin@tcd.ie" data-copy="fgavin@tcd.ie">email</a>
      or
      <a class="content-link" href="https://linkedin.com/in/fionngavin" target="_blank" rel="noopener noreferrer">message</a>
      and I'll send it your way.
    </p>
  </section>
</Base>
