---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { postByline } from '../lib/blog';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const recent = posts.slice(0, 4);

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
---

<Base>
<div class="page-sections">
  <section class="intro">
    <h1>Fionn Gavin</h1>
    <p>
      I'm a computer science student at
      <a class="content-link" href="https://www.tcd.ie/" target="_blank" rel="noopener noreferrer">Trinity College Dublin</a>,
      based in Dublin, Ireland. I work as an intern at
      <a class="content-link" href="https://www.projecteleven.com" target="_blank" rel="noopener noreferrer">Project&nbsp;Eleven</a>
      where I work on post-quantum cryptography infrastructure.
    </p>
    <p>
      I'm interested in understanding how things break, and how to build them so they don't.
    </p>
    <div class="links">
      <a href="mailto:fgavin@tcd.ie" data-copy="fgavin@tcd.ie"><span class="arw">✉</span> Email</a>
      <a href="https://linkedin.com/in/fionngavin" target="_blank" rel="noopener noreferrer"><span class="arw">↗</span> LinkedIn</a>
      <a href="https://github.com/fionngavin48" target="_blank" rel="noopener noreferrer"><span class="arw">↗</span> GitHub</a>
      <a href="/contact/#cv"><span class="arw">↓</span> CV</a>
    </div>
  </section>

  <section class="block" id="experience">
    <h2 class="section-title">Experience</h2>
    <div class="prose home-prose">
      <ul class="experience-list">
        <li>
          <div>
            <strong><a class="company-link" href="https://www.projecteleven.com" target="_blank" rel="noopener noreferrer">Project Eleven</a></strong>: research, engineering, authoring, building
            <a href="https://report.projecteleven.com/" target="_blank" rel="noopener noreferrer">post-quantum</a>
            cryptography infrastructure.
          </div>
          <div class="tags"><span>cryptography</span><span>research</span><span>engineering</span></div>
        </li>
        <li>
          <div>
            <strong><a class="company-link" href="https://www.ibm.com" target="_blank" rel="noopener noreferrer">IBM</a></strong>: collaborative software engineering project, security validation for MCP.
          </div>
          <div class="tags"><span>security</span><span>python</span><span>mcp</span></div>
        </li>
        <li>
          <div>
            <strong><a class="company-link" href="https://www.nccgroup.com" target="_blank" rel="noopener noreferrer">NCC Group</a></strong>: cybersecurity and pentesting.
          </div>
          <div class="tags"><span>cybersecurity</span><span>pentesting</span><span>dfir</span></div>
        </li>
      </ul>
    </div>
  </section>

  <section class="block" id="projects">
    <div class="section-head">
      <h2 class="section-title"><a href="/projects/">Projects</a></h2>
      <a class="see-all" href="/projects/">all →</a>
    </div>
    <div class="projects-list">
      {
        featured.map((p) => (
          <article class="project">
            <h3>
              <a
                class="project-title"
                href={p.data.writeup ? `/projects/${p.id}/` : (p.data.repo ?? '/projects/')}
                target={!p.data.writeup && p.data.repo ? '_blank' : undefined}
                rel={!p.data.writeup && p.data.repo ? 'noopener noreferrer' : undefined}
              >
                {p.data.title}
              </a>
            </h3>
            <p>{p.data.summary}</p>
            <div class="tags">{p.data.tags.map((t) => <span>{t}</span>)}</div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="block" id="writing">
    <div class="section-head">
      <h2 class="section-title"><a href="/writing/">Writing</a></h2>
      {recent.length > 0 && <a class="see-all" href="/writing/">all →</a>}
    </div>
    {
      recent.length > 0 ? (
        <div class="writing-list">
          {recent.map((p) => (
            <div class="post">
              <a class="post-title" href={`/writing/${p.id}/`}>{p.data.title}</a>
              <p class="post-meta">{postByline(p.data)}</p>
            </div>
          ))}
        </div>
      ) : (
        <p class="muted-copy">
          See my
          <a class="content-link" href="/writing/#articles">articles</a>
          and
          <a class="content-link" href="/writing/#papers">papers</a>.
        </p>
      )
    }
  </section>

  <section class="block" id="education">
    <h2 class="section-title">Education</h2>
    <div class="prose home-prose">
      <ul>
        <li>
          <strong>Trinity College Dublin</strong>: currently studying
          <a href="https://www.tcd.ie/courses/undergraduate/courses/computer-science/" target="_blank" rel="noopener noreferrer">Integrated Computer Science</a>
          B.A. (Mod.) Honours in Computer Science / Masters in Computer Science (M.C.S.).
        </li>
      </ul>
    </div>
  </section>

  <section class="block" id="skills">
    <h2 class="section-title">Skills</h2>
    <div class="prose home-prose">
      <p>Cryptography, systems security, systems programming.</p>
      <p class="skills-more muted-copy">See my <a class="content-link" href="/projects/">projects</a>.</p>
      <div class="tags">
        <span>Python</span><span>Java</span><span>C</span><span>R</span><span>JavaScript</span><span>HTML</span><span>Assembly</span><span>Git</span>
      </div>
    </div>
  </section>
</div>
</Base>
